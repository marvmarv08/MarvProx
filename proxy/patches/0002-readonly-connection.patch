new file mode 100644
index 0000000..00d7792
--- /dev/null
+++ b/src/inventory/inventory_decoder.cpp
@@ -0,0 +1,23 @@
+#include "inventory_decoder.hpp"
+#include <unordered_set>
+namespace inventory {
+std::optional<std::vector<InventoryEntry>> decode_candidate(std::span<const std::byte> bytes)
+{
+    if (bytes.size()<7 || bytes[0]!=std::byte{1}) return std::nullopt;
+    const auto u8=[&](std::size_t p){return std::to_integer<std::uint32_t>(bytes[p]);};
+    const auto capacity=u8(1)|(u8(2)<<8)|(u8(3)<<16)|(u8(4)<<24);
+    const auto count=u8(5)|(u8(6)<<8);
+    if(capacity>4096 || count>capacity || bytes.size()!=7+4*count) return std::nullopt;
+    std::vector<InventoryEntry> entries; entries.reserve(count);
+    std::unordered_set<std::uint32_t> seen;
+    for(std::size_t n=0;n<count;++n) {
+        const auto pos=7+n*4;
+        const auto id=u8(pos)|(u8(pos+1)<<8);
+        const auto quantity=u8(pos+2);
+        // The last record byte is opaque; do not mistake it for high quantity bits.
+        if(quantity==0 || !seen.insert(id).second) return std::nullopt;
+        entries.push_back({id,quantity});
+    }
+    return entries;
+}
+}

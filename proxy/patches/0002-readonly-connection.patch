new file mode 100644
index 0000000..5b11a1a
--- /dev/null
+++ b/src/core/connection_policy.hpp
@@ -0,0 +1,43 @@
+#pragma once
+#include <charconv>
+#include <string>
+#include <string_view>
+#include <stdexcept>
+namespace core {
+enum class RuntimeMode { OfflineSmoke, ReadOnlyConnection };
+class ConnectionPolicy {
+public:
+    ConnectionPolicy()=default;
+    static ConnectionPolicy read_only(std::string hostname,int timeout) {
+        if(!official_hostname(hostname) || timeout<1 || timeout>3600) throw std::invalid_argument{"Connection settings invalid"};
+        return ConnectionPolicy{std::move(hostname),timeout};
+    }
+    static bool official_hostname(std::string_view host) {
+        return host=="www.growtopia1.com" || host=="www.growtopia2.com" || host=="growtopia1.com" || host=="growtopia2.com";
+    }
+    bool allow_upstream() const {return mode_==RuntimeMode::ReadOnlyConnection;}
+    const std::string& hostname() const {return hostname_;}
+    int timeout_seconds() const {return timeout_;}
+    bool permits_endpoint(std::string_view host,int port) const {return allow_upstream() && port>0 && port<=65535 && public_ipv4(host);}
+    static bool public_ipv4(std::string_view host) {
+        unsigned parts[4]{};
+        for(int n=0;n<4;++n) {
+            const auto dot=host.find('.');
+            const auto piece=host.substr(0,dot);
+            if(piece.empty() || (piece.size()>1 && piece[0]=='0')) return false;
+            const auto [end,error]=std::from_chars(piece.data(),piece.data()+piece.size(),parts[n]);
+            if(error!=std::errc{} || end!=piece.data()+piece.size() || parts[n]>255) return false;
+            if(n<3) {if(dot==host.npos)return false;host.remove_prefix(dot+1);} else if(dot!=host.npos)return false;
+        }
+        const auto a=parts[0],b=parts[1],c=parts[2];
+        return a!=0 && a!=10 && a!=127 && a<224 && !(a==100 && b>=64 && b<=127) &&
+            !(a==169 && b==254) && !(a==172 && b>=16 && b<=31) && !(a==192 && (b==168 || (b==0 && (c==0 || c==2)) || (b==88 && c==99))) &&
+            !(a==198 && (b==18 || b==19 || (b==51 && c==100))) && !(a==203 && b==0 && c==113);
+    }
+private:
+    ConnectionPolicy(std::string host,int timeout):mode_{RuntimeMode::ReadOnlyConnection},hostname_{std::move(host)},timeout_{timeout}{}
+    RuntimeMode mode_{RuntimeMode::OfflineSmoke};
+    std::string hostname_;
+    int timeout_{1};
+};
+}

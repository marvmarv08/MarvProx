diff --git a/src/ui/status_model.hpp b/src/ui/status_model.hpp
new file mode 100644
index 0000000..8396fd4
--- /dev/null
+++ b/src/ui/status_model.hpp
@@ -0,0 +1,22 @@
+#pragma once
+#include <string>
+#include "../core/connection_state.hpp"
+#include "../inventory/inventory_state.hpp"
+namespace ui {
+struct StatusView {std::wstring heading; std::wstring rows;};
+class StatusModel {
+public:
+    StatusView present(core::ConnectionState state,const inventory::InventorySnapshot& snapshot) const {
+        const auto label=state==core::ConnectionState::Connected ? L"Connected" : state==core::ConnectionState::Starting ? L"Starting" :
+            state==core::ConnectionState::Failed ? L"Connection failed" : state==core::ConnectionState::Disconnected ? L"Disconnected" : L"Stopped";
+        StatusView view{std::wstring{label}+L" | Inventory unavailable",{}};
+        if(state==core::ConnectionState::Connected && snapshot.status==inventory::InventoryStatus::Candidate) {
+            view.heading=std::wstring{label}+L" | UNVERIFIED candidate inventory";
+            view.rows=L"Item ID\tQuantity\r\n";
+            for(const auto& entry:snapshot.entries) view.rows+=std::to_wstring(entry.item_id)+L"\t"+std::to_wstring(entry.quantity)+L"\r\n";
+        }
+        if(snapshot.status==inventory::InventoryStatus::Stale) view.heading=std::wstring{label}+L" | Inventory stale; waiting for full refresh";
+        return view;
+    }
+};
+}
diff --git a/src/ui/status_window.cpp b/src/ui/status_window.cpp
new file mode 100644
index 0000000..6211e1b
--- /dev/null
+++ b/src/ui/status_window.cpp
@@ -0,0 +1,77 @@
+#include "status_window.hpp"
+#ifdef _WIN32
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#include <chrono>
+#include <stdexcept>
+namespace ui {
+namespace {
+struct WindowContext {
+    inventory::InventoryState& inventory;
+    core::ConnectionStatus& connection;
+    bool smoke;
+    HWND heading{};
+    HWND rows{};
+    StatusModel model;
+    std::chrono::steady_clock::time_point start{std::chrono::steady_clock::now()};
+};
+LRESULT CALLBACK window_proc(HWND window,UINT message,WPARAM wparam,LPARAM lparam)
+{
+    auto* context=reinterpret_cast<WindowContext*>(GetWindowLongPtrW(window,GWLP_USERDATA));
+    if(message==WM_NCCREATE) {
+        context=static_cast<WindowContext*>(reinterpret_cast<CREATESTRUCTW*>(lparam)->lpCreateParams);
+        SetWindowLongPtrW(window,GWLP_USERDATA,reinterpret_cast<LONG_PTR>(context));
+    }
+    if(!context)return DefWindowProcW(window,message,wparam,lparam);
+    if(message==WM_CREATE) {
+        context->heading=CreateWindowW(L"STATIC",L"Starting read-only view",WS_CHILD|WS_VISIBLE,16,16,650,40,window,nullptr,nullptr,nullptr);
+        CreateWindowW(L"STATIC",L"Read-only candidate. No item dropping. Close this window to stop.",WS_CHILD|WS_VISIBLE,16,62,650,26,window,nullptr,nullptr,nullptr);
+        context->rows=CreateWindowExW(WS_EX_CLIENTEDGE,L"EDIT",L"",WS_CHILD|WS_VISIBLE|WS_VSCROLL|ES_MULTILINE|ES_READONLY,16,98,650,360,window,nullptr,nullptr,nullptr);
+        if(!context->heading || !context->rows)return -1;
+        SetTimer(window,1,100,nullptr);return 0;
+    }
+    if(message==WM_TIMER) {
+        const auto elapsed=std::chrono::steady_clock::now()-context->start;
+        if(context->smoke && elapsed>std::chrono::milliseconds{1700}) {
+            context->inventory.invalidate();context->connection.set(core::ConnectionState::Disconnected);
+        }
+        auto view=context->model.present(context->connection.get(),context->inventory.snapshot());
+        SetWindowTextW(context->heading,view.heading.c_str());SetWindowTextW(context->rows,view.rows.c_str());
+        if(context->smoke && elapsed>std::chrono::milliseconds{3200})PostMessageW(window,WM_CLOSE,0,0);
+        return 0;
+    }
+    if(message==WM_CLOSE) {context->connection.cancel();DestroyWindow(window);return 0;}
+    if(message==WM_DESTROY) {KillTimer(window,1);PostQuitMessage(0);return 0;}
+    return DefWindowProcW(window,message,wparam,lparam);
+}
+}
+int StatusWindow::run(inventory::InventoryState& inventory,core::ConnectionStatus& connection,bool smoke)
+{
+    const auto instance=GetModuleHandleW(nullptr);
+    const wchar_t* class_name=L"MarvProxReadOnlyWindow";
+    WNDCLASSW definition{};definition.lpfnWndProc=window_proc;definition.hInstance=instance;
+    definition.lpszClassName=class_name;definition.hCursor=LoadCursorW(nullptr,MAKEINTRESOURCEW(32512));
+    definition.hbrBackground=reinterpret_cast<HBRUSH>(COLOR_WINDOW+1);
+    if(!RegisterClassW(&definition) && GetLastError()!=ERROR_CLASS_ALREADY_EXISTS)throw std::runtime_error{"Window initialization failed"};
+    WindowContext context{inventory,connection,smoke};
+    const auto window=CreateWindowW(class_name,L"MarvProx - Read-only connection",WS_OVERLAPPEDWINDOW,
+        CW_USEDEFAULT,CW_USEDEFAULT,710,520,nullptr,nullptr,instance,&context);
+    if(!window)throw std::runtime_error{"Window initialization failed"};
+    ShowWindow(window,SW_SHOW);UpdateWindow(window);
+    MSG message{};
+    while(const auto result=GetMessageW(&message,nullptr,0,0)) {
+        if(result==-1){connection.cancel();DestroyWindow(window);return 1;}
+        TranslateMessage(&message);DispatchMessageW(&message);
+    }
+    connection.cancel();return 0;
+}
+}
+#else
+#include <stdexcept>
+int ui::StatusWindow::run(inventory::InventoryState&,core::ConnectionStatus&,bool){throw std::runtime_error{"Windows UI required"};}
+#endif

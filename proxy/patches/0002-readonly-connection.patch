+#include <gtest/gtest.h>
+#include "ui/status_model.hpp"
+
+TEST(StatusSnapshot, LabelsCandidateAndNeverAddsGameplayControl)
+{
+    ui::StatusModel model;
+    inventory::InventorySnapshot candidate{1,inventory::InventoryStatus::Candidate,{{100,12}}};
+    auto view=model.present(core::ConnectionState::Connected,candidate);
+    EXPECT_NE(view.heading.find(L"UNVERIFIED"),std::wstring::npos);
+    EXPECT_NE(view.rows.find(L"100"),std::wstring::npos);
+    auto disconnected=model.present(core::ConnectionState::Disconnected,candidate);
+    EXPECT_TRUE(disconnected.rows.empty());
+}
+TEST(StatusSnapshot, StaleAndUnavailableNeverShowInventory)
+{
+    ui::StatusModel model;
+    for(auto status:{inventory::InventoryStatus::Unavailable,inventory::InventoryStatus::Stale}) {
+        auto view=model.present(core::ConnectionState::Connected,{2,status,{{100,12}}});
+        EXPECT_TRUE(view.rows.empty());
+    }
+}

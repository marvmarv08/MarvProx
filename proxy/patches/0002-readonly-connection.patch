+++ b/tests/core/test_readonly_web.cpp
@@ -0,0 +1,85 @@
+#include <gtest/gtest.h>
+#include <sstream>
+#include <future>
+#include "core/verified_upstream.hpp"
+#include <spdlog/sinks/ostream_sink.h>
+#include "core/web_server.hpp"
+#include "core/probe_sink.hpp"
+#include "network/enet_runtime.hpp"
+#include "test_workspace.hpp"
+
+TEST(ReadOnlyWeb, ForwardsToLocalTlsFixtureAndValidatesReturnedRoute)
+{
+    TestWorkspace workspace;workspace.certificates();
+    network::ENetRuntime networking;
+    const int port=available_test_port();workspace.configure(port);
+    core::Config config;
+    event::Dispatcher dispatcher;
+    network::Server game(config,dispatcher);
+    network::Client client(config,dispatcher);
+    auto policy=core::ConnectionPolicy::read_only("www.growtopia1.com",30);
+    const auto certificate=std::filesystem::path{std::getenv("MARVPROX_TEST_CERT_DIR")};
+    httplib::SSLServer fixture{(certificate/"cert.pem").string().c_str(),(certificate/"key.pem").string().c_str()};
+    std::atomic<bool> private_route{};std::atomic<int> received{};
+    fixture.Post("/growtopia/server_data.php",[&](const httplib::Request& request,httplib::Response& response){
+        if(request.body=="SYNTHETIC_BODY_SECRET")++received;
+        response.set_content(private_route ? "server|127.0.0.1\nport|17091\n" : "server|1.1.1.1\nport|17091\n","text/plain");
+    });
+    const int upstream_port=fixture.bind_to_any_port("127.0.0.1");ASSERT_GT(upstream_port,0);
+    std::jthread upstream_thread([&]{fixture.listen_after_bind();});
+    fixture.wait_until_ready();
+    struct StopFixture {httplib::SSLServer& fixture;~StopFixture(){fixture.stop();}} stop{fixture};
+    std::ostringstream output;
+    auto sink=std::make_shared<spdlog::sinks::ostream_sink_mt>(output);sink->set_pattern("%v");
+    auto logger=std::make_shared<spdlog::logger>("readonly-web",std::make_shared<core::ProbeSink>(sink));
+    auto previous=spdlog::default_logger();spdlog::set_default_logger(logger);
+    struct Restore {std::shared_ptr<spdlog::logger> logger;~Restore(){spdlog::set_default_logger(logger);}} restore{previous};
+    {
+        core::WebServer web(config,dispatcher,client,game,policy,[&](const httplib::Request& request)->std::optional<std::string>{
+            httplib::SSLClient upstream{"127.0.0.1",upstream_port};
+            upstream.set_ca_cert_path((certificate/"cert.pem").string());upstream.set_connection_timeout(3,0);upstream.set_read_timeout(3,0);
+            const auto result=upstream.Post("/growtopia/server_data.php",request.body,"text/plain");
+            if(!result || result->status!=200)return std::nullopt;return result->body;
+        });
+        httplib::SSLClient local{"127.0.0.1",port};
+        local.set_ca_cert_path((certificate/"cert.pem").string());local.set_connection_timeout(3,0);local.set_read_timeout(3,0);
+        const auto response=local.Post("/growtopia/server_data.php",httplib::Headers{{"Authorization","SYNTHETIC_HEADER_SECRET"},{"Host","attacker.invalid"}},"SYNTHETIC_BODY_SECRET","text/plain");
+        ASSERT_TRUE(response);EXPECT_EQ(response->status,200);EXPECT_NE(response->body.find("server|127.0.0.1"),std::string::npos);EXPECT_EQ(received.load(),1);
+        private_route=true;
+        const auto rejected=local.Post("/growtopia/server_data.php","SYNTHETIC_BODY_SECRET","text/plain");
+        ASSERT_TRUE(rejected);EXPECT_EQ(rejected->status,502);
+    }
+    logger->flush();EXPECT_TRUE(output.str().empty());
+}
+TEST(ReadOnlyWeb, ClosingWithStalledUpstreamHonorsRequestTimeout)
+{
+    TestWorkspace workspace;workspace.certificates();network::ENetRuntime networking;
+    const int port=available_test_port();workspace.configure(port);core::Config config;
+    event::Dispatcher dispatcher;network::Server game(config,dispatcher);network::Client client(config,dispatcher);
+    const auto certificate=std::filesystem::path{std::getenv("MARVPROX_TEST_CERT_DIR")};
+    httplib::SSLServer fixture{(certificate/"cert.pem").string().c_str(),(certificate/"key.pem").string().c_str()};
+    std::promise<void> arrived;auto ready=arrived.get_future();std::atomic<bool> release{};
+    fixture.Get("/",[&](const auto&,auto& response){
+        arrived.set_value();const auto deadline=std::chrono::steady_clock::now()+std::chrono::seconds{10};
+        while(!release && std::chrono::steady_clock::now()<deadline)std::this_thread::sleep_for(std::chrono::milliseconds{10});
+        response.set_content("server|1.1.1.1\nport|17091\n","text/plain");
+    });
+    const int upstream_port=fixture.bind_to_any_port("127.0.0.1");ASSERT_GT(upstream_port,0);
+    std::jthread fixture_thread([&]{fixture.listen_after_bind();});fixture.wait_until_ready();
+    struct StopFixture {std::atomic<bool>& release;httplib::SSLServer& fixture;~StopFixture(){release=true;fixture.stop();}} stop{release,fixture};
+    auto web=std::make_unique<core::WebServer>(config,dispatcher,client,game,
+        core::ConnectionPolicy::read_only("www.growtopia1.com",30),[&](const auto&)->std::optional<std::string>{
+            auto upstream=core::make_verified_upstream("127.0.0.1",upstream_port);
+            upstream->set_ca_cert_path((certificate/"cert.pem").string());
+            const auto response=upstream->Get("/");if(!response)return std::nullopt;return response->body;
+        });
+    std::jthread request([&]{
+        httplib::SSLClient local{"127.0.0.1",port};local.set_ca_cert_path((certificate/"cert.pem").string());
+        local.set_connection_timeout(3,0);local.set_read_timeout(8,0);
+        const auto result=local.Post("/growtopia/server_data.php","SYNTHETIC_STALLED_REQUEST","text/plain");
+    });
+    ASSERT_EQ(ready.wait_for(std::chrono::seconds{5}),std::future_status::ready);
+    const auto before=std::chrono::steady_clock::now();web.reset();
+    EXPECT_LT(std::chrono::steady_clock::now()-before,std::chrono::seconds{7});
+    release=true;request.join();
+}

--- /dev/null
+++ b/tests/core/test_forwarding.cpp
@@ -0,0 +1,34 @@
+#include <gtest/gtest.h>
+#include "core/handlers/forwarding_handler.hpp"
+#include "network/connection.hpp"
+#include "packet/packet_decoder.hpp"
+
+class RecordingConnection final : public network::IConnection {
+public:
+    mutable std::vector<std::vector<std::byte>> sent;
+    bool write(std::span<const std::byte> data, int = 0) const override
+    {
+        sent.emplace_back(data.begin(), data.end());
+        return true;
+    }
+    bool write(const std::vector<std::byte>& data, int channel = 0) const override
+    {
+        return write(std::span{ data }, channel);
+    }
+    bool is_connected() const override { return true; }
+};
+
+TEST(ProbeForwarding, UnknownPacketsAreForwardedWithoutRewriting)
+{
+    event::Dispatcher dispatcher;
+    RecordingConnection client;
+    RecordingConnection server;
+    core::handlers::ForwardingHandler forwarding{ dispatcher, client, server };
+    const std::vector<std::byte> bytes{ std::byte{ 0xfe }, std::byte{ 0xfe }, std::byte{ 0xfe }, std::byte{ 0xfe }, std::byte{ 0xab } };
+    EXPECT_FALSE(packet::PacketDecoder::decode(bytes, core::Config::LogConfig{}, "ServerBound").has_value());
+    dispatcher.dispatch(event::RawPacketEvent{ event::Type::ServerBoundPacket, bytes });
+    EXPECT_EQ(client.sent, (std::vector<std::vector<std::byte>>{ bytes }));
+    EXPECT_TRUE(server.sent.empty());
+    dispatcher.dispatch(event::RawPacketEvent{ event::Type::ClientBoundPacket, bytes });
+    EXPECT_EQ(server.sent, (std::vector<std::vector<std::byte>>{ bytes }));
+}

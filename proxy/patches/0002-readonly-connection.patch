+#include <gtest/gtest.h>
+#include "core/connection_policy.hpp"
+#include "core/connection_state.hpp"
+
+TEST(ConnectionPolicy, OfflineCannotConnectEvenWithConfiguredHost)
+{
+    core::ConnectionPolicy policy;
+    EXPECT_FALSE(policy.allow_upstream());
+    EXPECT_FALSE(policy.permits_endpoint("1.1.1.1",17091));
+}
+TEST(ConnectionPolicy, RejectsUnrelatedHostAndInvalidTimeout)
+{
+    EXPECT_THROW(core::ConnectionPolicy::read_only("attacker.invalid",30),std::invalid_argument);
+    EXPECT_THROW(core::ConnectionPolicy::read_only("www.growtopia1.com",0),std::invalid_argument);
+    EXPECT_THROW(core::ConnectionPolicy::read_only("www.growtopia1.com",3601),std::invalid_argument);
+}
+TEST(ConnectionPolicy, ExplicitLiveModeAcceptsOnlyPublicNumericEndpoint)
+{
+    auto p=core::ConnectionPolicy::read_only("www.growtopia1.com",30);
+    EXPECT_TRUE(p.allow_upstream());
+    EXPECT_TRUE(p.permits_endpoint("1.1.1.1",17091));
+    for (auto host : {"127.0.0.1","10.0.0.1","192.168.1.1","169.254.1.2","172.16.1.1","100.64.0.1","0.0.0.0","224.1.1.1","198.18.0.1","192.0.2.1","localhost","1.1.1.1.evil","::1"})
+        EXPECT_FALSE(p.permits_endpoint(host,17091))<<host;
+    EXPECT_FALSE(p.permits_endpoint("1.1.1.1",0));
+    EXPECT_FALSE(p.permits_endpoint("1.1.1.1",65536));
+}
+TEST(ConnectionState, CancelAndTransitionsAreThreadSafe)
+{
+    core::ConnectionStatus state;
+    EXPECT_EQ(state.get(),core::ConnectionState::Stopped);
+    state.set(core::ConnectionState::Starting);
+    EXPECT_EQ(state.get(),core::ConnectionState::Starting);
+    state.cancel();
+    EXPECT_TRUE(state.cancelled());
+}

--- /dev/null
+++ b/src/network/probe_host.cpp
@@ -0,0 +1,25 @@
+#include "probe_host.hpp"
+#include "../core/probe_policy.hpp"
+
+namespace network {
+namespace {
+ENetHost* create_host(std::uint16_t port, bool server)
+{
+    ENetAddress address{};
+    if (enet_address_set_host_ip(&address, core::ProbePolicy::listen_address()) != 0) return nullptr;
+    address.port = port;
+    auto* host = enet_host_create(&address, 1, 2, 0, 0);
+    if (!host) return nullptr;
+    if (enet_host_compress_with_range_coder(host) != 0) {
+        enet_host_destroy(host);
+        return nullptr;
+    }
+    host->checksum = enet_crc32;
+    if (server) host->usingNewPacketForServer = 1;
+    else host->usingNewPacket = 1;
+    return host;
+}
+}
+ENetHost* create_probe_server_host(std::uint16_t port) { return create_host(port, true); }
+ENetHost* create_probe_client_host() { return create_host(0, false); }
+}

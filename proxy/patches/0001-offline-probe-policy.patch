+TEST(ProbeDispatch, DeliversEventAndHonorsCancellation)
+{
+    event::Dispatcher dispatcher;
+    int first{};
+    int later{};
+    dispatcher.append_listener(event::Type::ClientConnect, [&](const event::Event& incoming) {
+        ++first;
+        incoming.cancel();
+    });
+    dispatcher.append_listener(event::Type::ClientConnect, [&](const event::Event&) { ++later; });

diff --git a/src/core/handlers/inventory_handler.cpp b/src/core/handlers/inventory_handler.cpp
new file mode 100644
index 0000000..3d424ad
--- /dev/null
+++ b/src/core/handlers/inventory_handler.cpp
@@ -0,0 +1,53 @@
+#include "inventory_handler.hpp"
+#include "../../packet/game/inventory.hpp"
+#include "../../packet/packet_decoder.hpp"
+#include "../probe_sink.hpp"
+namespace core::handlers {
+InventoryHandler::InventoryHandler(event::Dispatcher& dispatcher,inventory::InventoryState& state,ConnectionStatus* status)
+{
+    const auto listen=[&](event::Type type,event::Dispatcher::Callback callback){
+        handles_.emplace_back(dispatcher,type,dispatcher.append_listener(type,callback,event::Priority::Highest));
+    };
+    listen(event::packet_event_type(packet::PacketId::SendInventoryState),[&state](const event::Event& e){
+        const auto* update=dynamic_cast<const event::TypedPacketEvent<packet::PacketId::SendInventoryState>*>(&e);
+        if(update && update->is_client_bound()) {
+            const auto packet=update->get<packet::game::SendInventoryState>();
+            if(packet) state.accept_candidate(packet->extra);
+        }
+    });
+    listen(event::packet_event_type(packet::PacketId::ModifyItemInventory),[&state](const event::Event& e){
+        const auto* update=dynamic_cast<const event::TypedPacketEvent<packet::PacketId::ModifyItemInventory>*>(&e);
+        if(update && update->is_client_bound()) state.invalidate();
+    });
+    listen(event::packet_event_type(packet::PacketId::Disconnect),[&state,status](const event::Event& e){
+        if(dynamic_cast<const event::TypedPacketEvent<packet::PacketId::Disconnect>*>(&e)) {
+            state.invalidate();
+            if(status)status->set(ConnectionState::Disconnected);
+        }
+    });
+    listen(event::packet_event_type(packet::PacketId::OnSendToServer),[&state](const event::Event& e){
+        const auto* update=dynamic_cast<const event::TypedPacketEvent<packet::PacketId::OnSendToServer>*>(&e);
+        if(update && update->is_client_bound()) state.invalidate();
+    });
+    for(auto type:{event::Type::ClientConnect,event::Type::ServerConnect,event::Type::ClientDisconnect,event::Type::ServerDisconnect})
+        listen(type,[&state,status,type](const event::Event&){
+            state.invalidate();
+            if(status) {
+                const auto value=type==event::Type::ServerConnect ? ConnectionState::Connected :
+                    type==event::Type::ClientConnect ? ConnectionState::Starting : ConnectionState::Disconnected;
+                status->set(value);
+            }
+        });
+    listen(event::Type::ClientBoundPacket,[&state](const event::Event& e){
+        const auto* raw=dynamic_cast<const event::RawPacketEvent*>(&e);
+        if(!raw || raw->data.size()<5 || raw->data[0]!=std::byte{4} || (raw->data[4]!=std::byte{9} && raw->data[4]!=std::byte{13} && raw->data[4]!=std::byte{1})) return;
+        if(raw->data[4]==std::byte{13}) {state.invalidate();return;}
+        if(raw->data.size()<4+sizeof(packet::GameUpdatePacket)) {state.invalidate();return;}
+        packet::GameUpdatePacket packet{};
+        std::memcpy(&packet,raw->data.data()+4,sizeof(packet));
+        if(packet.data_size!=raw->data.size()-4-sizeof(packet)) {state.invalidate();return;}
+        // Raw forwarding also carries rejected typed packets; never retain inventory across a rejected handoff.
+        if(raw->data[4]==std::byte{1} && !packet::PacketDecoder::decode(raw->data,{},"ClientBound",true)) state.invalidate();
+    });
+}
+}

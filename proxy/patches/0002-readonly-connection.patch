@@ -0,0 +1,18 @@
+#include "inventory_state.hpp"
+namespace inventory {
+InventorySnapshot InventoryState::snapshot() const {std::lock_guard lock(mutex_);return snapshot_;}
+bool InventoryState::accept_candidate(std::span<const std::byte> bytes)
+{
+    auto parsed=decode_candidate(bytes);
+    std::lock_guard lock(mutex_);
+    ++snapshot_.generation;
+    snapshot_.entries=parsed ? std::move(*parsed) : std::vector<InventoryEntry>{};
+    snapshot_.status=parsed ? InventoryStatus::Candidate : InventoryStatus::Stale;
+    return parsed.has_value();
+}
+void InventoryState::invalidate()
+{
+    std::lock_guard lock(mutex_);++snapshot_.generation;
+    snapshot_.status=InventoryStatus::Stale;snapshot_.entries.clear();
+}
+}

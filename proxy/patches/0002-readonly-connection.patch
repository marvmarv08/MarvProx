+namespace network {
+struct SafeDnsRecord {int type{};std::string data;};
+struct SafeDnsResponse {int Status{-1};std::vector<SafeDnsRecord> Answer;};
+inline std::string parse_dns_answer(std::string_view body) {
+    if(body.size()>65536)return {};
+    SafeDnsResponse response;
+    if(glz::read<glz::opts{.error_on_unknown_keys=false}>(response,body) || response.Status!=0)return {};
+    for(const auto& record:response.Answer)
+        if(record.type==1 && core::ConnectionPolicy::public_ipv4(record.data))return record.data;
+    return {};
+}
+}

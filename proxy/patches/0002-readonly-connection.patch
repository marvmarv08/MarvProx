+#include <gtest/gtest.h>
+#include <thread>
+#include <cstring>
+#include "packet/packet_decoder.hpp"
+#include "packet/register_packets.hpp"
+#include "inventory/inventory_state.hpp"
+#include "core/handlers/inventory_handler.hpp"
+#include "packet/game/inventory.hpp"
+
+namespace {
+// Candidate layout only: v1, u32 capacity, u16 count, u16 ID/u8 count/u8 opaque flags.
+const std::vector<std::byte> sample{std::byte{1},std::byte{20},std::byte{0},std::byte{0},std::byte{0},std::byte{2},std::byte{0},
+ std::byte{100},std::byte{0},std::byte{12},std::byte{0},std::byte{101},std::byte{0},std::byte{1},std::byte{1}};
+}
+TEST(InventoryState, CompleteSnapshotRemainsCandidate)
+{
+    inventory::InventoryState state;
+    EXPECT_EQ(state.snapshot().status, inventory::InventoryStatus::Unavailable);
+    ASSERT_TRUE(state.accept_candidate(sample));
+    auto snapshot=state.snapshot();
+    EXPECT_EQ(snapshot.status, inventory::InventoryStatus::Candidate);
+    ASSERT_EQ(snapshot.entries.size(), 2);
+    EXPECT_EQ(snapshot.entries[0].item_id, 100);
+    EXPECT_EQ(snapshot.entries[0].quantity, 12);
+    EXPECT_EQ(snapshot.entries[1].quantity, 1);
+}
+TEST(InventoryState, EveryTruncationClearsOldSnapshot)
+{
+    inventory::InventoryState state;
+    for(std::size_t n=0;n<sample.size();++n) {
+        ASSERT_TRUE(state.accept_candidate(sample));
+        const auto generation=state.snapshot().generation;
+        EXPECT_FALSE(state.accept_candidate(std::span{sample}.first(n)));
+        EXPECT_TRUE(state.snapshot().entries.empty());
+        EXPECT_EQ(state.snapshot().status, inventory::InventoryStatus::Stale);
+        EXPECT_GT(state.snapshot().generation, generation);
+    }
+}
+TEST(InventoryState, RejectsUnknownDuplicateExcessAndTrailingRecords)
+{
+    inventory::InventoryState state;
+    auto bytes=sample; bytes[0]=std::byte{2}; EXPECT_FALSE(state.accept_candidate(bytes));
+    bytes=sample; bytes[5]=std::byte{255}; EXPECT_FALSE(state.accept_candidate(bytes));
+    bytes=sample; bytes[11]=std::byte{100}; EXPECT_FALSE(state.accept_candidate(bytes));
+    bytes=sample; bytes.push_back(std::byte{0}); EXPECT_FALSE(state.accept_candidate(bytes));
+    bytes=sample; bytes[1]=std::byte{1}; EXPECT_FALSE(state.accept_candidate(bytes));
+}
+TEST(InventoryState, ChangesAndConcurrentReadsNeverKeepOldEntries)
+{
+    inventory::InventoryState state;
+    std::thread writer([&]{for(int n=0;n<100;++n) {state.accept_candidate(sample);state.invalidate();}});
+    for(int n=0;n<100;++n) {auto s=state.snapshot();EXPECT_TRUE(s.entries.empty() || s.status==inventory::InventoryStatus::Candidate);}
+    writer.join();
+    EXPECT_TRUE(state.snapshot().entries.empty());
+}
+TEST(InventoryObserver, IgnoresWrongDirectionAndClearsOnHandoffDisconnect)
+{
+    event::Dispatcher dispatcher;
+    inventory::InventoryState state;
+    core::handlers::InventoryHandler observer(dispatcher,state);
+    auto packet=std::make_shared<packet::game::SendInventoryState>(); packet->extra=sample;
+    dispatcher.dispatch(event::TypedPacketEvent<packet::PacketId::SendInventoryState>{event::Direction::ServerBound,packet});
+    EXPECT_TRUE(state.snapshot().entries.empty());
+    dispatcher.dispatch(event::TypedPacketEvent<packet::PacketId::SendInventoryState>{event::Direction::ClientBound,packet});
+    ASSERT_EQ(state.snapshot().entries.size(),2);
+    dispatcher.dispatch(event::ConnectionEvent{event::Type::ServerDisconnect});
+    EXPECT_TRUE(state.snapshot().entries.empty());
+    state.accept_candidate(sample);
+    auto handoff=std::make_shared<packet::game::OnSendToServer>();
+    dispatcher.dispatch(event::TypedPacketEvent<packet::PacketId::OnSendToServer>{event::Direction::ClientBound,handoff});
+    EXPECT_TRUE(state.snapshot().entries.empty());
+}
+TEST(InventoryObserver, ForcedDisconnectClearsSnapshotAndConnectionState)
+{
+    event::Dispatcher dispatcher;inventory::InventoryState state;core::ConnectionStatus status;
+    status.set(core::ConnectionState::Connected);
+    core::handlers::InventoryHandler observer(dispatcher,state,&status);
+    state.accept_candidate(sample);
+    auto packet=std::make_shared<packet::game::Disconnect>();
+    dispatcher.dispatch(event::TypedPacketEvent<packet::PacketId::Disconnect>{event::Direction::ServerBound,packet});
+    EXPECT_TRUE(state.snapshot().entries.empty());
+    EXPECT_EQ(status.get(),core::ConnectionState::Disconnected);
+}
+TEST(InventoryObserver, RejectedCallFunctionInvalidatesBeforeRawForwarding)
+{
+    packet::register_all_packets();
+    event::Dispatcher dispatcher;inventory::InventoryState state;
+    core::handlers::InventoryHandler observer(dispatcher,state);
+    bool forwarded{};std::vector<std::byte> forwarded_bytes;
+    std::ignore=dispatcher.append_listener(event::Type::ClientBoundPacket,[&](const event::Event& e){
+        const auto* raw=dynamic_cast<const event::RawPacketEvent*>(&e);ASSERT_NE(raw,nullptr);
+        EXPECT_TRUE(state.snapshot().entries.empty());forwarded=true;
+        forwarded_bytes.assign(raw->data.begin(),raw->data.end());
+    });
+    const packet::PacketVariant unsupported{std::string{"OnSendToServer"},std::int32_t{17091}};
+    for(const auto& extra:std::vector<std::vector<std::byte>>{
+        {std::byte{1},std::byte{0},std::byte{2},std::byte{255},std::byte{255},std::byte{255},std::byte{127}},unsupported.serialize()}) {
+        state.accept_candidate(sample);forwarded=false;
+        const auto type=packet::NET_MESSAGE_GAME_PACKET;packet::GameUpdatePacket header{};
+        header.type=packet::PACKET_CALL_FUNCTION;header.data_size=static_cast<std::uint32_t>(extra.size());
+        std::vector<std::byte> bytes(sizeof(type)+sizeof(header)+extra.size());
+        std::memcpy(bytes.data(),&type,sizeof(type));std::memcpy(bytes.data()+sizeof(type),&header,sizeof(header));
+        std::copy(extra.begin(),extra.end(),bytes.end()-extra.size());
+        ASSERT_FALSE(packet::PacketDecoder::decode(bytes,{},"test",true));
+        dispatcher.dispatch(event::RawPacketEvent{event::Type::ClientBoundPacket,bytes});
+        EXPECT_TRUE(state.snapshot().entries.empty());EXPECT_TRUE(forwarded);EXPECT_EQ(forwarded_bytes,bytes);
+    }
+}
+TEST(InventoryObserver, ValidUnrelatedCallFunctionPreservesCandidate)
+{
+    packet::register_all_packets();
+    event::Dispatcher dispatcher;inventory::InventoryState state;
+    core::handlers::InventoryHandler observer(dispatcher,state);state.accept_candidate(sample);
+    const packet::PacketVariant value{std::string{"OnConsoleMessage"},std::string{"SYNTHETIC_NOTICE"}};
+    const auto extra=value.serialize();const auto type=packet::NET_MESSAGE_GAME_PACKET;
+    packet::GameUpdatePacket header{};header.type=packet::PACKET_CALL_FUNCTION;header.data_size=static_cast<std::uint32_t>(extra.size());
+    std::vector<std::byte> bytes(sizeof(type)+sizeof(header)+extra.size());
+    std::memcpy(bytes.data(),&type,sizeof(type));std::memcpy(bytes.data()+sizeof(type),&header,sizeof(header));
+    std::copy(extra.begin(),extra.end(),bytes.end()-extra.size());
+    ASSERT_TRUE(packet::PacketDecoder::decode(bytes,{},"test",true));
+    dispatcher.dispatch(event::RawPacketEvent{event::Type::ClientBoundPacket,bytes});
+    EXPECT_EQ(state.snapshot().entries.size(),2);
+}
diff --git a/tests/core/test_packet_bounds.cpp b/tests/core/test_packet_bounds.cpp
new file mode 100644
index 0000000..44ae2bd
--- /dev/null
+++ b/tests/core/test_packet_bounds.cpp
@@ -0,0 +1,85 @@
+#include <gtest/gtest.h>
+#include <cstring>
+#include "packet/packet_decoder.hpp"
+#include "packet/register_packets.hpp"
+#include "packet/game/inventory.hpp"
+#include "packet/game/server.hpp"
+
+namespace {
+std::vector<std::byte> inventory_packet(std::uint32_t declared, std::size_t available)
+{
+    packet::GameUpdatePacket header{};
+    header.type = packet::PACKET_SEND_INVENTORY_STATE;
+    header.data_size = declared;
+    const auto type = packet::NET_MESSAGE_GAME_PACKET;
+    std::vector<std::byte> bytes(sizeof(type) + sizeof(header) + available);
+    std::memcpy(bytes.data(), &type, sizeof(type));
+    std::memcpy(bytes.data() + sizeof(type), &header, sizeof(header));
+    return bytes;
+}
+}
+TEST(PacketBounds, RejectsAllTruncatedGameHeaders)
+{
+    packet::register_all_packets();
+    auto bytes = inventory_packet(0, 0);
+    for (std::size_t size = 0; size < bytes.size(); ++size)
+        EXPECT_FALSE(packet::PacketDecoder::decode(std::span{bytes}.first(size), {}, "test")) << size;
+}
+TEST(PacketBounds, RejectsDeclaredExtraBeyondAvailableBytes)
+{
+    packet::register_all_packets();
+    EXPECT_FALSE(packet::PacketDecoder::decode(inventory_packet(1000, 3), {}, "test"));
+}
+TEST(PacketBounds, RejectsUnaccountedTrailingBytes)
+{
+    packet::register_all_packets();
+    EXPECT_FALSE(packet::PacketDecoder::decode(inventory_packet(2, 4), {}, "test"));
+    EXPECT_FALSE(packet::PacketDecoder::decode(inventory_packet(0, 4), {}, "test"));
+}
+TEST(PacketBounds, AcceptsExactInventoryEnvelope)
+{
+    packet::register_all_packets();
+    const auto result = packet::PacketDecoder::decode(inventory_packet(3, 3), {}, "test");
+    ASSERT_TRUE(result);
+    const auto parsed = std::dynamic_pointer_cast<packet::game::SendInventoryState>(*result);
+    ASSERT_NE(parsed, nullptr);
+    EXPECT_EQ(parsed->extra.size(), 3);
+}
+TEST(PacketBounds, RejectsOversizedAndUnterminatedText)
+{
+    const auto type = packet::NET_MESSAGE_GENERIC_TEXT;
+    std::vector<std::byte> bytes(70000, std::byte{'x'});
+    std::memcpy(bytes.data(), &type, sizeof(type));
+    bytes.back() = std::byte{0};
+    EXPECT_FALSE(packet::PacketDecoder::decode(bytes, {}, "test"));
+    bytes.resize(sizeof(type));
+    EXPECT_FALSE(packet::PacketDecoder::decode(bytes, {}, "test"));
+}
+TEST(PacketBounds, ObserverSkipsUnneededGameParsers)
+{
+    auto bytes=inventory_packet(0,0);
+    bytes[4]=std::byte{16};
+    EXPECT_FALSE(packet::PacketDecoder::decode(bytes,{},"test",true));
+}
+TEST(PacketBounds, MalformedVariantsNeverBecomePlausibleHandoffs)
+{
+    for (const auto& extra:std::vector<std::vector<std::byte>>{
+        {std::byte{1},std::byte{0},std::byte{2},std::byte{255},std::byte{255},std::byte{255},std::byte{127}},
+        {std::byte{1},std::byte{7},std::byte{5},std::byte{1},std::byte{0},std::byte{0},std::byte{0}}}) {
+        auto bytes=inventory_packet(static_cast<std::uint32_t>(extra.size()),extra.size());
+        bytes[4]=std::byte{1};
+        std::copy(extra.begin(),extra.end(),bytes.end()-extra.size());
+        EXPECT_FALSE(packet::PacketDecoder::decode(bytes,{},"test",true));
+    }
+}
+TEST(PacketBounds, HandoffPreservesOpaqueSuffixAndAdditionalFields)
+{
+    packet::PacketVariant value{std::string{"OnSendToServer"},std::int32_t{17091},std::int32_t{1},std::int32_t{2},
+        std::string{"1.1.1.1|SYNTHETIC_DOOR|SYNTHETIC_SESSION|SYNTHETIC_EXTRA"},std::uint32_t{0},std::string{"SYNTHETIC_USER"},std::string{"SYNTHETIC_TOP_EXTRA"}};
+    packet::Payload input=packet::VariantPayload{packet::GameUpdatePacket{},value};
+    packet::game::OnSendToServer handoff;ASSERT_TRUE(handoff.read(input));
+    handoff.address="127.0.0.1";handoff.port=16999;
+    const auto output=handoff.write();const auto* updated=std::get_if<packet::VariantPayload>(&output);ASSERT_NE(updated,nullptr);
+    EXPECT_EQ(updated->variant.get<std::string>(4),"127.0.0.1|SYNTHETIC_DOOR|SYNTHETIC_SESSION|SYNTHETIC_EXTRA");
+    EXPECT_EQ(updated->variant.get<std::string>(7),"SYNTHETIC_TOP_EXTRA");
+}
diff --git a/tests/core/test_readonly_web.cpp b/tests/core/test_readonly_web.cpp

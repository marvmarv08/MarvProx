@@ -0,0 +1,15 @@
+#pragma once
+#include <atomic>
+namespace core {
+enum class ConnectionState { Stopped, Starting, Connected, Disconnected, Failed };
+class ConnectionStatus {
+public:
+    ConnectionState get() const {return state_.load();}
+    void set(ConnectionState state){state_.store(state);}
+    void cancel(){cancelled_.store(true);}
+    bool cancelled() const {return cancelled_.load();}
+private:
+    std::atomic<ConnectionState> state_{ConnectionState::Stopped};
+    std::atomic<bool> cancelled_{};
+};
+}

+++ b/tests/core/test_startup.cpp
@@ -0,0 +1,94 @@
+#include <gtest/gtest.h>
+#include "core/core.hpp"
+#include "network/probe_host.hpp"
+#include "test_workspace.hpp"
+
+namespace {
+int available_udp_port()
+{
+    network::ENetRuntime runtime;
+    auto* host = network::create_probe_server_host(0);
+    if (!host) throw std::runtime_error{ "UDP fixture allocation failed" };
+    const int port = host->address.port;
+    enet_host_destroy(host);
+    return port;
+}
+void expect_udp_released(int port)
+{
+    network::ENetRuntime runtime;
+    auto* host = network::create_probe_server_host(static_cast<std::uint16_t>(port));
+    EXPECT_NE(host, nullptr) << "Failed startup retained its UDP socket";
+    if (host) enet_host_destroy(host);
+}
+template<class Start> void expect_failure(Start start, const std::string& expected)
+{
+    try { start(); FAIL() << "Startup unexpectedly succeeded"; }
+    catch (const std::exception& error) { EXPECT_EQ(error.what(), expected); }
+}
+void expect_corrected_startup(TestWorkspace& workspace, int web_port, int udp_port)
+{
+    workspace.certificates();
+    workspace.configure(web_port, udp_port);
+    core::Core corrected;
+    corrected.run_for(std::chrono::milliseconds{ 10 });
+}
+}
+
+TEST(ProbeStartup, MissingCertificateFailsWithoutTerminating)
+{
+    TestWorkspace workspace;
+    const int udp_port = available_udp_port();
+    workspace.configure(0, udp_port);
+    expect_failure([] { core::Core runtime; }, "Probe TLS certificate unavailable");
+    expect_udp_released(udp_port);
+    expect_corrected_startup(workspace, 0, udp_port);
+}
+
+TEST(ProbeStartup, OccupiedPortFailsWithoutTerminating)
+{
+    TestWorkspace workspace;
+    workspace.certificates();
+    const int udp_port = available_udp_port();
+    int web_port{};
+    {
+        network::ENetRuntime networking;
+        ENetAddress address{};
+        ASSERT_EQ(enet_address_set_host_ip(&address, "127.0.0.1"), 0);
+        const auto socket = enet_socket_create(ENET_SOCKET_TYPE_STREAM);
+        ASSERT_NE(socket, ENET_SOCKET_NULL);
+        ASSERT_EQ(enet_socket_bind(socket, &address), 0);
+        ASSERT_EQ(enet_socket_listen(socket, 1), 0);
+        ASSERT_EQ(enet_socket_get_address(socket, &address), 0);
+        web_port = address.port;
+        workspace.configure(web_port, udp_port);
+        expect_failure([] { core::Core runtime; }, "Probe HTTPS port unavailable");
+        expect_udp_released(udp_port);
+        enet_socket_destroy(socket);
+    }
+    expect_corrected_startup(workspace, web_port, udp_port);
+}
+
+TEST(ProbeStartup, FailureAfterHttpsStartReleasesSocketsAndAllowsRestart)
+{
+    TestWorkspace workspace;
+    workspace.certificates();
+    const int web_port = available_test_port();
+    const int udp_port = available_udp_port();
+    workspace.configure(web_port, udp_port);
+    expect_failure([] {
+        core::Core runtime{ [] { throw std::runtime_error{ "Controlled post-listener failure" }; } };
+    }, "Controlled post-listener failure");
+    expect_udp_released(udp_port);
+    expect_corrected_startup(workspace, web_port, udp_port);
+}
+
+TEST(ProbeStartup, RepeatedStartupAndShutdownReleasesPorts)
+{
+    TestWorkspace workspace;
+    const int web_port = available_test_port();
+    const int udp_port = available_udp_port();
+    for (int attempt = 0; attempt < 3; ++attempt) {
+        expect_corrected_startup(workspace, web_port, udp_port);
+        expect_udp_released(udp_port);
+    }
+}
diff --git a/tests/core/test_verified_tls.cpp b/tests/core/test_verified_tls.cpp
new file mode 100644
index 0000000..e4c2dad
--- /dev/null
+++ b/tests/core/test_verified_tls.cpp
@@ -0,0 +1,31 @@
+#include <gtest/gtest.h>
+#include <cstdlib>
+#include <filesystem>
+#include <thread>
+#include "core/verified_upstream.hpp"
+
+TEST(ProbeTls, RejectsAnUntrustedServerCertificate)
+{
+    const char* directory = std::getenv("MARVPROX_TEST_CERT_DIR");
+    ASSERT_NE(directory, nullptr) << "Generate a disposable local test certificate before running this test";
+    const auto root = std::filesystem::path{ directory };
+    httplib::SSLServer server{ (root / "cert.pem").string().c_str(), (root / "key.pem").string().c_str() };
+    ASSERT_TRUE(server.is_valid());
+    server.Get("/", [](const httplib::Request&, httplib::Response& response) { response.set_content("local fixture", "text/plain"); });
+    const int port = server.bind_to_any_port("127.0.0.1");
+    ASSERT_GT(port, 0);
+    std::thread listener{ [&] { server.listen_after_bind(); } };
+    httplib::SSLClient trusted{ "127.0.0.1", port };
+    trusted.set_ca_cert_path((root / "cert.pem").string());
+    trusted.set_connection_timeout(3, 0);
+    trusted.set_read_timeout(3, 0);
+    const auto positive = trusted.Get("/");
+    auto client = core::make_verified_upstream("127.0.0.1", port);
+    const auto result = client->Get("/");
+    server.stop();
+    listener.join();
+    EXPECT_TRUE(positive) << "The same fixture must work when its CA is trusted for this client only";
+    if (positive) EXPECT_EQ(positive->body, "local fixture");
+    EXPECT_FALSE(result) << "An untrusted self-signed certificate must fail verification";
+    EXPECT_EQ(result.error(), httplib::Error::SSLServerVerification);
+}
diff --git a/tests/core/test_workspace.hpp b/tests/core/test_workspace.hpp
new file mode 100644
index 0000000..ddde530
--- /dev/null
+++ b/tests/core/test_workspace.hpp
@@ -0,0 +1,61 @@
+#pragma once
+#include <chrono>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <random>
+#include <stdexcept>
+#include <enet/enet.h>
+
+class TestWorkspace {
+public:
+    TestWorkspace() : previous_{ std::filesystem::current_path() }
+    {
+        directory_ = std::filesystem::temp_directory_path() / ("marvprox-probe-" +
+            std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()) + "-" + std::to_string(std::random_device{}()));
+        if (!std::filesystem::create_directory(directory_)) throw std::runtime_error{ "Test workspace collision" };
+        std::filesystem::current_path(directory_);
+        configure(0);
+    }
+    ~TestWorkspace()
+    {
+        std::error_code error;
+        std::filesystem::current_path(previous_, error);
+        std::filesystem::remove_all(directory_, error);
+    }
+    void configure(int web_port, int udp_port = 0)
+    {
+        std::ofstream config{ "config.json" };
+        config << "{\"server\":{\"port\":" << udp_port << ",\"web_port\":" << web_port << "},\"log\":{\"print_message\":true,\"print_game_update_packet\":true,\"print_variant\":true,\"print_extra\":true}}";
+        if (!config) throw std::runtime_error{ "Test config write failed" };
+    }
+    void certificates()
+    {
+        const auto* input = std::getenv("MARVPROX_TEST_CERT_DIR");
+        if (!input) throw std::runtime_error{ "Disposable test certificate is required" };
+        std::filesystem::create_directory("resources");
+        for (const auto* name : { "cert.pem", "key.pem" }) {
+            std::filesystem::copy_file(std::filesystem::path{ input } / name,
+                std::filesystem::path{ "resources" } / name, std::filesystem::copy_options::overwrite_existing);
+        }
+    }
+private:
+    std::filesystem::path previous_;
+    std::filesystem::path directory_;
+};
+
+inline int available_test_port()
+{
+    if (enet_initialize() != 0) throw std::runtime_error{ "Test network initialization failed" };
+    ENetAddress address{};
+    enet_address_set_host_ip(&address, "127.0.0.1");
+    const auto socket = enet_socket_create(ENET_SOCKET_TYPE_STREAM);
+    if (socket == ENET_SOCKET_NULL || enet_socket_bind(socket, &address) != 0 || enet_socket_get_address(socket, &address) != 0) {
+        if (socket != ENET_SOCKET_NULL) enet_socket_destroy(socket);
+        enet_deinitialize();
+        throw std::runtime_error{ "Test port allocation failed" };
+    }
+    enet_socket_destroy(socket);
+    enet_deinitialize();
+    return address.port;
+}

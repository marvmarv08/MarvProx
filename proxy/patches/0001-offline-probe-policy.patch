+#include <gtest/gtest.h>
+#include <sstream>
+#include <spdlog/sinks/ostream_sink.h>
+#include <spdlog/spdlog.h>
+
+#include "core/probe_policy.hpp"
+#include "core/core.hpp"
+#include "core/probe_sink.hpp"
+#include "network/probe_host.hpp"
+#include "network/client.hpp"
+#include "packet/packet_decoder.hpp"
+#include "test_workspace.hpp"
+
+TEST(ProbePolicy, CommandsStayDisabledWithExistingConfig)
+{
+    TestWorkspace workspace;
+    core::Config legacy;
+    int commands{};
+    int scripts{};
+    core::ProbePolicy::initialize_extensions([&] { ++commands; }, [&] { ++scripts; });
+    EXPECT_EQ(commands, 0);
+    EXPECT_EQ(scripts, 0);
+    EXPECT_FALSE(legacy.get_log_config().print_message);
+    EXPECT_FALSE(legacy.get_log_config().print_extra);
+}
+
+TEST(ProbePolicy, ScriptsAreNotLoaded)
+{
+    bool script_executed{};
+    core::ProbePolicy::initialize_extensions([] {}, [&] { script_executed = true; });
+    EXPECT_FALSE(script_executed);
+}
+
+TEST(ProbePolicy, HeadersBodiesAndPacketsDoNotReachLogs)
+{
+    std::ostringstream output;
+    auto destination = std::make_shared<spdlog::sinks::ostream_sink_mt>(output);
+    destination->set_pattern("%v");
+    auto filter = std::make_shared<core::ProbeSink>(destination);
+    auto logger = std::make_shared<spdlog::logger>("probe-test", filter);
+    const auto previous = spdlog::default_logger();
+    spdlog::set_default_logger(logger);
+    struct RestoreLogger {
+        std::shared_ptr<spdlog::logger> saved;
+        ~RestoreLogger() { spdlog::set_default_logger(saved); }
+    } restore{ previous };
+    TestWorkspace workspace;
+    workspace.certificates();
+    const int web_port = available_test_port();
+    workspace.configure(web_port);
+    {
+        core::Core runtime;
+        httplib::SSLClient client{ "127.0.0.1", web_port };
+        const auto root = std::filesystem::path{ std::getenv("MARVPROX_TEST_CERT_DIR") };
+        client.set_ca_cert_path((root / "cert.pem").string());
+        client.set_connection_timeout(3, 0);
+        client.set_read_timeout(3, 0);
+        const auto result = client.Post("/growtopia/server_data.php",
+            httplib::Headers{ { "Authorization", "SYNTHETIC_HEADER_SECRET" } },
+            "password=SYNTHETIC_BODY_SECRET", "application/x-www-form-urlencoded");
+        ASSERT_TRUE(result);
+        EXPECT_EQ(result->status, 503);
+        EXPECT_EQ(result->body, "Offline probe: upstream connections are disabled");
+        const auto path = client.Get("/SYNTHETIC_PATH_SECRET");
+        ASSERT_TRUE(path);
+        EXPECT_EQ(path->status, 404);
+    }
+    const std::string message{ "password|SYNTHETIC_PACKET_SECRET\n" };
+    std::vector<std::byte> payload{ std::byte{ 2 }, std::byte{ 0 }, std::byte{ 0 }, std::byte{ 0 } };
+    for (const char ch : message) payload.push_back(static_cast<std::byte>(ch));
+    payload.push_back(std::byte{ 0 });
+    core::Config::LogConfig legacy{ true, true, true, true };
+    std::ignore = packet::PacketDecoder::decode(payload, legacy, "ServerBound");
+    core::emit_probe_event(core::ProbeEvent::Ready);
+    logger->flush();
+    EXPECT_EQ(output.str().find("SYNTHETIC_"), std::string::npos);
+    EXPECT_NE(output.str().find("probe.ready"), std::string::npos);
+    EXPECT_EQ(output.str().find("probe.ready"), output.str().rfind("probe.ready"));
+    auto normalized = output.str();
+    std::erase(normalized, '\r');
+    EXPECT_EQ(normalized, "probe.ready\n");
+}
+
+TEST(ProbePolicy, ListenersBindOnlyLoopback)
+{
+    ASSERT_EQ(enet_initialize(), 0);
+    auto* host = network::create_probe_server_host(0);
+    ASSERT_NE(host, nullptr);
+    char address[64]{};
+    EXPECT_EQ(enet_address_get_host_ip(&host->address, address, sizeof(address)), 0);
+    EXPECT_STREQ(address, "127.0.0.1");
+    EXPECT_NE(host->address.port, 0);
+    enet_host_destroy(host);
+    enet_deinitialize();
+}

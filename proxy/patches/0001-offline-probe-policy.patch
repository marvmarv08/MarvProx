diff --git a/src/core/probe_policy.hpp b/src/core/probe_policy.hpp
new file mode 100644
index 0000000..16351f0
--- /dev/null
+++ b/src/core/probe_policy.hpp
@@ -0,0 +1,19 @@
+#pragma once
+#include <utility>
+
+namespace core {
+struct ProbePolicy {
+    [[nodiscard]] static constexpr bool allow_commands() { return false; }
+    [[nodiscard]] static constexpr bool allow_scripts() { return false; }
+    [[nodiscard]] static constexpr bool allow_payload_logging() { return false; }
+    [[nodiscard]] static constexpr bool allow_upstream_connections() { return false; }
+    [[nodiscard]] static constexpr const char* listen_address() { return "127.0.0.1"; }
+
+    template<typename Commands, typename Scripts>
+    static void initialize_extensions(Commands&& commands, Scripts&& scripts)
+    {
+        if (allow_commands()) std::forward<Commands>(commands)();
+        if (allow_scripts()) std::forward<Scripts>(scripts)();
+    }
+};
+}
diff --git a/src/core/probe_sink.hpp b/src/core/probe_sink.hpp
new file mode 100644
index 0000000..293b92a
--- /dev/null
+++ b/src/core/probe_sink.hpp
@@ -0,0 +1,43 @@
+#pragma once
+#include <mutex>
+#include <string_view>
+#include <spdlog/spdlog.h>
+#include <spdlog/sinks/base_sink.h>
+
+namespace core {
+enum class ProbeEvent { Starting, Ready, StartupFailed, Stopped };
+
+inline std::string_view probe_event_name(ProbeEvent event)
+{
+    switch (event) {
+    case ProbeEvent::Starting: return "probe.starting";
+    case ProbeEvent::Ready: return "probe.ready";
+    case ProbeEvent::StartupFailed: return "probe.startup_failed";
+    case ProbeEvent::Stopped: return "probe.stopped";
+    }
+    return "probe.startup_failed";
+}
+
+class ProbeSink final : public spdlog::sinks::base_sink<std::mutex> {
+public:
+    explicit ProbeSink(spdlog::sink_ptr destination) : destination_{ std::move(destination) } { }
+private:
+    void sink_it_(const spdlog::details::log_msg& message) override
+    {
+        const std::string_view content{ message.payload.data(), message.payload.size() };
+        for (const auto event : { ProbeEvent::Starting, ProbeEvent::Ready, ProbeEvent::StartupFailed, ProbeEvent::Stopped }) {
+            if (content == probe_event_name(event)) {
+                destination_->log(message);
+                return;
+            }
+        }
+    }
+    void flush_() override { destination_->flush(); }
+    spdlog::sink_ptr destination_;
+};
+
+inline void emit_probe_event(ProbeEvent event)
+{
+    spdlog::info("{}", probe_event_name(event));
+}
+}
diff --git a/src/core/verified_upstream.hpp b/src/core/verified_upstream.hpp
new file mode 100644
index 0000000..246d05b
--- /dev/null
+++ b/src/core/verified_upstream.hpp
@@ -0,0 +1,16 @@
+#pragma once
+#include <memory>
+#include <string>
+#include <httplib.h>
+
+namespace core {
+inline std::unique_ptr<httplib::SSLClient> make_verified_upstream(const std::string& hostname, int port = 443)
+{
+    auto client = std::make_unique<httplib::SSLClient>(hostname, port);
+    client->enable_server_certificate_verification(true);
+    client->set_connection_timeout(3, 0);
+    client->set_read_timeout(3, 0);
+    client->set_write_timeout(3, 0);
+    return client;
+}
+}
